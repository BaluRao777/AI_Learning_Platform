GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
JWT_SECRET=
JWT_EXPIRES_HOURS=24
FLASK_ENV=development
HOST=0.0.0.0
PORT=5000
CORS_ORIGINS=http://localhost:3000
MAX_TOPIC_LENGTH=120
RATE_LIMIT_PER_MINUTE=30


# ---- Input Analysis Layer (Qwen) ----
# false -> rule-based plan only
ANALYZER_ENABLED=true
QWEN_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
QWEN_LOAD_IN_4BIT=true
# true on laptop, false on workstation
QWEN_UNLOAD_AFTER_USE=true
QWEN_MAX_NEW_TOKENS=512

# ---- Image backend ----
# pollinations | local | remote | mixed
IMAGE_BACKEND=pollinations
SANA_MODEL_ID=Efficient-Large-Model/SANA1.5_1.6B_1024px_diffusers
# e.g. models_store/lora/pytorch_lora_weights.safetensors ; empty = base model
SANA_LORA_PATH=
SANA_LORA_SCALE=1.0
# optional: path to a LoRA-fused transformer folder (Phase 6)
SANA_FUSED_TRANSFORMER_PATH=
SANA_TEXT_ENCODER_4BIT=true
# none | model | sequential
SANA_OFFLOAD=model
SANA_HEIGHT=512
SANA_WIDTH=512
SANA_STEPS=20
SANA_GUIDANCE=4.5
SANA_NUM_IMAGES=5
# LoRA trigger word (must match training captions)
SANA_TRIGGER=edudiag
GENERATED_IMAGES_DIR=generated_images

# ---- Remote image server (workstation) ----
# e.g. http://192.168.1.50:7860
SANA_REMOTE_URL=
# shared secret
SANA_REMOTE_TOKEN=

# ---- Optional ----
# if local/remote fails, fall back to the old behaviour
IMAGE_FALLBACK_TO_POLLINATIONS=false

# ---- Mixed comparison mode (IMAGE_BACKEND=mixed) ----
# images in this order: base = SANA base, lora = SANA + LoRA, pollinations = Pollinations.ai
IMAGE_MIX=base:2,lora:1,pollinations:2
SANA_MIX_LORA_PATH=models_store/lora/pytorch_lora_weights.safetensors

# ---- Image proxy (Pollinations) ----
IMAGE_PROXY_TIMEOUT_SECONDS=30
